@model Intalnirea1.Models.PaginatedList<Intalnirea1.Models.BookListItem>

@{
    ViewData["Title"] = "Catalog";

    var prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    var nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<h1>Catalog</h1>

<p>
    <a asp-action="Create">Carte noua</a>
</p>

<!-- Cautare si filtrare -->
<form asp-action="Index" method="get" class="mb-4">

    <div class="row g-3 align-items-end">

        <div class="col-md-4">
            <label for="searchString" class="form-label">
                Cauta dupa titlu
            </label>
            <input type="text"
                   id="searchString"
                   name="searchString"
                   value="@ViewData["CurrentFilter"]"
                   class="form-control" />
        </div>

        <div class="col-md-2">
            <label for="minPrice" class="form-label">
                Pret minim
            </label>
            <input type="number"
                   id="minPrice"
                   name="minPrice"
                   min="0"
                   step="0.01"
                   value="@(((decimal?)ViewData["MinPrice"])?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"
                   class="form-control" />
        </div>

        <div class="col-md-2">
            <label for="maxPrice" class="form-label">
                Pret maxim
            </label>
            <input type="number"
                   id="maxPrice"
                   name="maxPrice"
                   min="0"
                   step="0.01"
                   value="@(((decimal?)ViewData["MaxPrice"])?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"
                   class="form-control" />
        </div>

        <div class="col-md-4">
            <input type="hidden"
                   name="sortOrder"
                   value="@ViewData["CurrentSort"]" />

            <button type="submit" class="btn btn-primary">
                Filtreaza
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Reseteaza
            </a>
        </div>

    </div>
</form>

<!-- Catalog -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["TitleSortParm"]"
                   asp-route-currentFilter="@ViewData["CurrentFilter"]"
                   asp-route-minPrice="@ViewData["MinPrice"]"
                   asp-route-maxPrice="@ViewData["MaxPrice"]">
                    Titlu
                </a>
            </th>

            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["AuthorSortParm"]"
                   asp-route-currentFilter="@ViewData["CurrentFilter"]"
                   asp-route-minPrice="@ViewData["MinPrice"]"
                   asp-route-maxPrice="@ViewData["MaxPrice"]">
                    Autor
                </a>
            </th>

            <th>Gen</th>

            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["PriceSortParm"]"
                   asp-route-currentFilter="@ViewData["CurrentFilter"]"
                   asp-route-minPrice="@ViewData["MinPrice"]"
                   asp-route-maxPrice="@ViewData["MaxPrice"]">
                    Pret
                </a>
            </th>

            <th>Comenzi</th>
            <th>Actiuni</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.Genre</td>
                <td>@item.Price.ToString("0.00")</td>
                <td>@item.Orders</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.ID">Edit</a> |

                    <a asp-action="Details"
                       asp-route-id="@item.ID">Details</a> |

                    <a asp-action="Delete"
                       asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>Nu au fost gasite carti pentru filtrele selectate.</p>
}

<!-- Paginare -->
<div class="mt-3">

    <a asp-action="Index"
       asp-route-sortOrder="@ViewData["CurrentSort"]"
       asp-route-pageNumber="@(Model.PageIndex - 1)"
       asp-route-currentFilter="@ViewData["CurrentFilter"]"
       asp-route-minPrice="@ViewData["MinPrice"]"
       asp-route-maxPrice="@ViewData["MaxPrice"]"
       class="btn btn-outline-primary @prevDisabled">
        Inapoi
    </a>

    <a asp-action="Index"
       asp-route-sortOrder="@ViewData["CurrentSort"]"
       asp-route-pageNumber="@(Model.PageIndex + 1)"
       asp-route-currentFilter="@ViewData["CurrentFilter"]"
       asp-route-minPrice="@ViewData["MinPrice"]"
       asp-route-maxPrice="@ViewData["MaxPrice"]"
       class="btn btn-outline-primary @nextDisabled">
        Inainte
    </a>

    <span class="ms-2">
        Pagina @Model.PageIndex din @Model.TotalPages
    </span>

</div>
