@model IEnumerable<Intalnirea1.Models.Order>

@{
    ViewData["Title"] = "Comenzi";
}

<h1>Comenzi</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Comanda noua
    </a>
</p>

<form asp-action="Index" method="get" class="mb-3">
    <label for="customerId">Filtreaza dupa cititor:</label>

    <select name="customerId"
            id="customerId"
            asp-items="ViewBag.Customers"
            class="form-select d-inline-block w-auto">
        <option value="">Toti cititorii</option>
    </select>

    <button type="submit" class="btn btn-secondary">
        Filtreaza
    </button>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Reseteaza
    </a>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Cititor</th>
            <th>Carte</th>
            <th>Data comenzii</th>
            <th>Actiuni</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Customer?.Name</td>
                <td>@item.Book?.Title</td>
                <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.OrderID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.OrderID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.OrderID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
