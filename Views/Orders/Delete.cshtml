@model Intalnirea1.Models.Order

@{
    ViewData["Title"] = "Stergere comanda";
}

<h1>Stergere comanda</h1>

<h4>Esti sigur ca vrei sa stergi aceasta comanda?</h4>

<hr />

<dl class="row">
    <dt class="col-sm-2">Cititor</dt>
    <dd class="col-sm-10">
        @Model.Customer?.Name
    </dd>

    <dt class="col-sm-2">Carte</dt>
    <dd class="col-sm-10">
        @Model.Book?.Title
    </dd>

    <dt class="col-sm-2">Data comenzii</dt>
    <dd class="col-sm-10">
        @Model.OrderDate.ToString("yyyy-MM-dd")
    </dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.OrderID" method="post">
    <input type="hidden" asp-for="OrderID" />

    <button type="submit" class="btn btn-danger">
        Sterge
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Anuleaza
    </a>
</form>
