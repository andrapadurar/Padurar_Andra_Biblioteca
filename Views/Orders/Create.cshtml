@model Intalnirea1.Models.Order

@{
    ViewData["Title"] = "Comanda noua";
}

<h1>Comanda noua</h1>

<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All"
                 class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="CustomerID" class="control-label">
                    Cititor
                </label>

                <select asp-for="CustomerID"
                        asp-items="ViewBag.CustomerID"
                        class="form-control">
                    <option value="">Selecteaza cititorul</option>
                </select>

                <span asp-validation-for="CustomerID"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BookID" class="control-label">
                    Carte
                </label>

                <select asp-for="BookID"
                        asp-items="ViewBag.BookID"
                        class="form-control">
                    <option value="">Selecteaza cartea</option>
                </select>

                <span asp-validation-for="BookID"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="OrderDate" class="control-label">
                    Data comenzii
                </label>

                <input asp-for="OrderDate"
                       type="date"
                       class="form-control"
                       value="@Model.OrderDate.ToString("yyyy-MM-dd")" />

                <span asp-validation-for="OrderDate"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Salveaza comanda
            </button>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Inapoi la lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
