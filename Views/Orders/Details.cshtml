@model Intalnirea1.Models.Order

@{
    ViewData["Title"] = "Detalii comanda";
}

<h1>Detalii comanda</h1>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Cititor</dt>
        <dd class="col-sm-10">
            @Model.Customer?.Name
        </dd>

        <dt class="col-sm-2">Carte</dt>
        <dd class="col-sm-10">
            @Model.Book?.Title
        </dd>

        <dt class="col-sm-2">Data comenzii</dt>
        <dd class="col-sm-10">
            @Model.OrderDate.ToString("yyyy-MM-dd")
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.OrderID">Edit</a> |
    <a asp-action="Index">Inapoi la lista</a>
</div>
