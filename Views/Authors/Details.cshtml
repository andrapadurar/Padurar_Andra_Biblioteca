@model Intalnirea1.Models.Author

@{
    ViewData["Title"] = "Detalii autor";

    var books = ViewBag.Books as List<Intalnirea1.Models.BookListItem>
                ?? new List<Intalnirea1.Models.BookListItem>();

    int totalOrders = ViewBag.TotalOrders ?? 0;
    var firstYear = ViewBag.FirstYear;
    var lastYear = ViewBag.LastYear;
}

<h1>Detalii autor</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">Prenume</dt>
    <dd class="col-sm-9">@Model.FirstName</dd>

    <dt class="col-sm-3">Nume</dt>
    <dd class="col-sm-9">@Model.LastName</dd>

    <dt class="col-sm-3">Nume complet</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Total comenzi</dt>
    <dd class="col-sm-9">@totalOrders</dd>

    <dt class="col-sm-3">Anul primei carti (B2)</dt>
    <dd class="col-sm-9">
        @(firstYear != null ? firstYear : "-")
    </dd>

    <dt class="col-sm-3">Anul ultimei carti (B2)</dt>
    <dd class="col-sm-9">
        @(lastYear != null ? lastYear : "-")
    </dd>
</dl>

<h3>Cartile autorului</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Titlu</th>
            <th>Gen</th>
            <th>Pret</th>
            <th>Numar comenzi</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var book in books)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Genre</td>
                <td>@book.Price.ToString("0.00")</td>
                <td>@book.Orders</td>
            </tr>
        }
    </tbody>
</table>

@if (!books.Any())
{
    <p>Acest autor nu are carti in catalog.</p>
}

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
